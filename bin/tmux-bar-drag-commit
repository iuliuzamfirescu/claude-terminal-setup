#!/usr/bin/env bash
# Commit whatever drag is in progress (pane or window), wherever the mouse
# was actually released, on the bar, over pane content, or a border.
# Shared by every release-catching binding so there's one place this logic
# lives, regardless of which surface the release lands on.
set -euo pipefail

window_id="$1"
session_name="$2"
client="$3"

commit_drag() {
  local source_option="$1" target_option="$2" move_script="$3" move_context="$4" state_file="$5"
  local src tgt
  src="$(tmux show -g -v "$source_option" 2>/dev/null || true)"
  [[ -n "$src" ]] || return 1
  tgt="$(tmux show -g -v "$target_option" 2>/dev/null || true)"
  if [[ -n "$tgt" && "$tgt" != "$src" ]]; then
    "$move_script" "$move_context" "$src" "$tgt" || true
  fi
  rm -f "$state_file" "${state_file}.pid"
  tmux set -gu "$source_option" \; set -gu "$target_option" \; refresh-client -S -t "$client"
}

commit_drag @dragSourcePane @dragInsertBefore ~/.local/bin/tmux-pane-bar-move "$window_id" \
  "/tmp/tmux-pane-bar-insert-${window_id}" && exit 0

commit_drag @dragSourceWin @dragInsertBeforeWin ~/.local/bin/tmux-window-bar-move "$session_name" \
  "/tmp/tmux-window-bar-insert-${session_name}" || true
