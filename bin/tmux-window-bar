#!/usr/bin/env bash
# Custom window bar: same pattern as tmux-pane-bar, but windows already have
# a native mutable order (window_index, reorderable via move-window) so no
# self-healing order tracking is needed here, just span tracking for the
# insertion marker.
set -euo pipefail

sess="$1"
insert_before="${2:-}"

mapfile -t lines < <(tmux list-windows -t "$sess" -F "#{window_id}|#{window_index}|#{window_active}|#{window_name}")

# one upfront pass instead of a per-window tmux list-panes call in the loop below
declare -A idle_window
while read -r win_id pane_id; do
  [[ -e "/tmp/tmux-claude-idle/${pane_id}" ]] && idle_window["$win_id"]=1
done < <(tmux list-panes -s -t "$sess" -F "#{window_id} #{pane_id}" 2>/dev/null)

marker='#[fg=yellow]▏#[default]'

out=""
spans=""
col=0
for line in "${lines[@]}"; do
  id="${line%%|*}"; rest="${line#*|}"
  index="${rest%%|*}"; rest="${rest#*|}"
  active="${rest%%|*}"; name="${rest#*|}"
  if [[ "$id" == "$insert_before" ]]; then
    out+="$marker"
  fi
  window_has_idle_claude="${idle_window[$id]:-0}"

  width=$(( ${#name} + 3 ))
  spans+="${id}:${col}:$(( col + width )) "
  col=$(( col + width ))

  if [[ "$active" == "1" ]]; then
    style='#{@pill_working_active}'
    (( window_has_idle_claude )) && style='#{@pill_idle_active}'
  elif (( window_has_idle_claude )); then
    style='#{@pill_idle_inactive}'
  else
    style='#{@pill_working_inactive}'
  fi
  out+="#[range=window|${index}]#[${style}] ${name} #[default] #[norange]"
done
if [[ "$insert_before" == "END" ]]; then
  out+="$marker"
fi

echo "$spans" > "/tmp/tmux-window-bar-spans-${sess}"
echo -e "$out"
